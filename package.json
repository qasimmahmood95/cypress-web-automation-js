{
  "name": "cypress-web-automation-js",
  "version": "2.0.0",
  "description": "Production-grade Cypress end-to-end test framework for the Sauce Labs demo store — Page Object Model, session-cached authentication, GitHub Actions CI, and HTML reporting.",
  "author": "Qasim Mahmood",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qasimmahmood95/cypress-web-automation-js.git"
  },
  "keywords": [
    "cypress",
    "e2e",
    "test-automation",
    "page-object-model",
    "javascript",
    "github-actions"
  ],
  "scripts": {
    "cy:open": "cypress open",
    "test": "cypress run",
    "test:chrome": "cypress run --browser chrome",
    "test:firefox": "cypress run --browser firefox",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "axe-core": "^4.12.1",
    "cypress": "^15.19.0",
    "cypress-axe": "^1.7.0",
    "cypress-mochawesome-reporter": "^4.0.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^6.4.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  }
}
